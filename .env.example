NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
# Project Traces page URL (SDK has no per-run URL helper). UI/README link with campaign id filter.
NEATLOGS_TRACES_URL=
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
CRUSTDATA_BASE_URL=https://api.crustdata.com
# Optional: email/people fallback after Crustdata (Email Finder + Domain Search)
HUNTER_API_KEY=
HUNTER_BASE_URL=https://api.hunter.io/v2
LLM_PROVIDER=bedrock
ANTHROPIC_API_KEY=
AWS_PROFILE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
DATA_MODE=replay
DEMO_MODE=true
ALLOW_LIVE_SENDS=false
SIGNALSDR_SECRET_KEY=
IMAP_POLL_SECONDS=60
MAX_CREDITS=400
SMTP_HOST=localhost
SMTP_PORT=1025
FROM_EMAIL=demo@signalsdr.local

# Google Calendar OAuth (separate test Google account; calendar.events only)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Local callback hits FastAPI directly (must also be listed in Google Cloud OAuth client).
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/calendar/oauth/callback
GOOGLE_CALENDAR_NOTIFY_ATTENDEES=false
UI_BASE_URL=http://localhost:3000

# Deploy (EC2 API + Vercel UI). Local defaults stay safe.
# API_HOST=0.0.0.0
# CORS_ORIGINS=http://localhost:3000,https://YOUR_PROJECT.vercel.app
# UI_BASE_URL=https://YOUR_PROJECT.vercel.app
# Cloud OAuth: Google redirects to Vercel /api → rewrite → EC2 (same path).
# GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR_PROJECT.vercel.app/api/calendar/oauth/callback
# In Google Cloud Console → Credentials → OAuth client → Authorized redirect URIs, add BOTH local and Vercel URIs.
# Do NOT put Bedrock/Crustdata/Hunter/Gmail secrets in Vercel — only on EC2 .env.
# Hackathon AWS allowance is EC2-only; use your own Bedrock keys on the instance.
