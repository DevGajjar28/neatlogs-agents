# Copy this file to .env and fill the empty values there.
# .env is gitignored. Do not commit keys or paste them into chat.

# neatlogs project API key (app.neatlogs.com → Settings → API keys).
# Use the project key, not the nlw_ HTTP ingest key.
NEATLOGS_API_KEY=

# Crustdata. Leave blank until a live run. Replay mode does not call the API.
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
CRUSTDATA_BASE_URL=https://api.crustdata.com

# AWS Bedrock via the named CLI profile. No access keys in this file.
LLM_PROVIDER=bedrock
AWS_PROFILE=
AWS_REGION=
# Bedrock model IDs or inference profile IDs, for example amazon.nova-pro-v1:0
LLM_MODEL_STRONG=
LLM_MODEL_FAST=

# replay = cache and fixtures only, no Crustdata calls. live = call Crustdata.
DATA_MODE=replay
DEMO_MODE=true
MAX_CREDITS=400

# Local SMTP catcher on this machine. Docker is not used.
SMTP_HOST=localhost
SMTP_PORT=1025
FROM_EMAIL=demo@signalsdr.local
